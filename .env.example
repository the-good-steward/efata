# Copy to .env.local and fill in real values.
# .env.local is gitignored. Never commit real keys.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers ---
# console.anthropic.com, question generation and answer evaluation
ANTHROPIC_API_KEY=
# console.deepgram.com, speech to text for recorded answers
DEEPGRAM_API_KEY=
# elevenlabs.io, text to speech for spoken feedback
ELEVENLABS_API_KEY=

# --- Testing ---
# Set to "true" to remove all per-user daily caps. No ceiling on spend
# while this is on: fine with a few known testers, unsafe once the app
# is open to strangers. Leave unset in normal operation.
EFATA_UNLIMITED=

# Set to "true" to pause new signups. Existing accounts keep working and
# sign-in stays open. Enforced in the page and the action.
EFATA_SIGNUPS_CLOSED=

# Set to "true" to evaluate answers with the cheaper, faster model.
# Roughly a third off the cost of a session. The numbers do not change
# either way, since filler counts and pace are computed in code; what
# may change is how the delivery sentence reads. Compare real answers
# before leaving it on.
EFATA_CHEAP_EVAL=
